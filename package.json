{
  "name": "advanced-infobox",
  "version": "0.1.1",
  "description": "Wiki-style infoboxes for Obsidian (https://obsidian.md) rendered from plain, flat frontmatter — your properties stay the single source of truth.",
  "keywords": [],
  "license": "MIT",
  "author": "Dwi Elfianto",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vp build --watch",
    "build": "vp build",
    "check": "vp fmt --check -c .oxfmtrc.json && vp lint -c .oxlintrc.json",
    "lint": "vp lint -c .oxlintrc.json",
    "lint:fix": "vp lint -c .oxlintrc.json --fix",
    "format": "vp fmt --write -c .oxfmtrc.json",
    "type-check": "bun x tsc --noEmit && bun x svelte-check --tsconfig tsconfig.json",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "@voidzero-dev/vite-plus-core": "^0.2.4",
    "builtin-modules": "^5.3.0",
    "obsidian": "^1.13.1",
    "playwright-core": "^1.61.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.4",
    "vitest": "4.1.10",
    "yaml": "^2.8.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.4"
  }
}
